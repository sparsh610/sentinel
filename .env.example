# Copy to .env and fill in. .env is gitignored - never commit real values.

SENTINEL_DB_URL=jdbc:postgresql://localhost:5432/sentinel
SENTINEL_DB_USER=sentinel
SENTINEL_DB_PASSWORD=sentinel

# Local models via Ollama (docker compose --profile llm up -d)
SENTINEL_LLM_BASE_URL=http://localhost:11434
SENTINEL_LLM_CHAT_MODEL=llama3.1:8b
SENTINEL_LLM_EMBEDDING_MODEL=nomic-embed-text

# Or an OpenAI-compatible endpoint instead. Leave blank to stay fully local.
SENTINEL_OPENAI_API_KEY=
