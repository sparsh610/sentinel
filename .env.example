# Copy to .env and fill in. .env is gitignored - never commit real values.

SENTINEL_DB_URL=jdbc:postgresql://localhost:5432/sentinel
SENTINEL_DB_USER=sentinel
SENTINEL_DB_PASSWORD=sentinel

# Local models via Ollama (docker compose --profile llm up -d)
SENTINEL_LLM_BASE_URL=http://localhost:11434
SENTINEL_LLM_CHAT_MODEL=llama3.1:8b
SENTINEL_LLM_EMBEDDING_MODEL=nomic-embed-text

# --- Optional: hosted chat model (profile "cloud") ---
# Moves generation off the laptop; embeddings still run locally, so the document corpus
# never leaves the machine. Any OpenAI-compatible endpoint works.
# Get a token at https://huggingface.co/settings/tokens - never commit it.
SENTINEL_HF_TOKEN=
SENTINEL_CHAT_BASE_URL=https://router.huggingface.co
SENTINEL_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
